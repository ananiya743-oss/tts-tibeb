# ===========================================
# TT's Tibeb — Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file to git.

# ----- App -----
APP_URL=http://localhost:3000
NODE_ENV=development

# ----- Database -----
# SQLite for dev, PostgreSQL for prod (e.g. postgresql://user:pass@host:5432/db)
DATABASE_URL=file:./db/custom.db

# ----- Admin Auth -----
# Random 32+ character string used to sign admin session JWTs
ADMIN_JWT_SECRET=change-me-to-a-random-secret

# ----- ARIF Pay (kept for reference — not used in order-request workflow) -----
# Get these from https://merchant.arifpay.net
ARIFPAY_API_KEY=
ARIFPAY_SECRET=
ARIFPAY_MERCHANT_ID=
ARIFPAY_CALLBACK_URL=http://localhost:3000/api/payments/arifpay/callback
ARIFPAY_ENV=sandbox  # sandbox | production

# ----- Email (SMTP) -----
# Used for order notifications to admin + customer confirmations.
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TT's Tibeb <orders@ttstibeb.com>"

# ----- Order notifications -----
# Where new order notifications are sent
ORDER_NOTIFY_EMAIL=ananiya743@gmail.com

# ----- Contact (defaults; editable from Admin Panel → Settings) -----
WHATSAPP_NUMBER=+251911234567
CONTACT_EMAIL=hello@ttstibeb.com
CONTACT_TELEGRAM=TTs2126
